<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Playtest64.Launcher.Views.MainWindow"
        Title="Playtest64 Launcher"
        Width="1000" Height="660" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Icon="avares://Playtest64Launcher/Assets/icon.png">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The bar on top -->
        <Border Grid.Row="0" Padding="24,14" BorderThickness="0,0,0,1"
                Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0" Source="avares://Playtest64Launcher/Assets/icon.png" Width="34" Height="34" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Playtest64" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                    <TextBlock Name="SeasonText" FontSize="12" Foreground="{DynamicResource ThemeDim}"/>
                </StackPanel>
                <TextBlock Name="UserText" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource ThemeDim}"/>
            </Grid>
        </Border>

        <!-- Signing in -->
        <Border Name="SignInPanel" Grid.Row="1" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="8" BorderThickness="1" Padding="26"
                Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}">
            <StackPanel Spacing="8">
                <TextBlock Text="Anmelden" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                <TextBlock Text="Mit deinem Playtest-Konto, dieselben Daten wie auf der Webseite."
                           TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"/>
                <TextBlock Text="E-Mail" Margin="0,10,0,0" Foreground="{DynamicResource ThemeMuted}"/>
                <TextBox Name="EmailBox"/>
                <TextBlock Text="Passwort" Foreground="{DynamicResource ThemeMuted}"/>
                <TextBox Name="PasswordBox" PasswordChar="•"/>
                <Button Name="SignInButton" Content="Anmelden" Classes="accent" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"
                        Click="SignInButton_OnClick"/>
            </StackPanel>
        </Border>

        <!-- The news on the left, playing on the right -->
        <Grid Name="BuildsPanel" Grid.Row="1" ColumnDefinitions="*,340" IsVisible="False">

            <ScrollViewer Grid.Column="0" Padding="24,20,12,20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Neuigkeiten" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Name="NewsStatus" Foreground="{DynamicResource ThemeDim}" TextWrapping="Wrap"/>
                    <StackPanel Name="NewsPanel" Spacing="14"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Margin="12,20,24,20" CornerRadius="8" BorderThickness="1" Padding="20"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Spielen" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Name="BuildBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="BuildBox_OnSelectionChanged"/>
                        <Button Name="ReloadButton" Grid.Column="1" Content="Neu laden" Margin="8,0,0,0" Click="ReloadButton_OnClick"/>
                    </Grid>
                    <Border BorderThickness="1" CornerRadius="4" Padding="10" Height="96" BorderBrush="{DynamicResource ThemeBorder}">
                        <ScrollViewer>
                            <TextBlock Name="NotesText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}"/>
                        </ScrollViewer>
                    </Border>
                    <Button Name="ActionButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="44" FontSize="15" Click="ActionButton_OnClick"/>
                    <ProgressBar Name="DownloadBar" Minimum="0" Maximum="1" Height="6"/>

                    <CheckBox Name="AutostartBox" Margin="0,10,0,0" Content="Nach Updates suchen, wenn ich mich anmelde"
                              IsCheckedChanged="AutostartBox_OnChanged"/>
                    <CheckBox Name="SeasonBox" Content="Saison-Look (wie auf der Webseite)" IsCheckedChanged="SeasonBox_OnChanged"/>
                    <Button Name="SignOutButton" Content="Abmelden" HorizontalAlignment="Left" Margin="0,6,0,0" Click="SignOutButton_OnClick"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- What is happening, or what went wrong -->
        <Border Grid.Row="2" Padding="24,8" MinHeight="34" BorderThickness="0,1,0,0"
                Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}">
            <TextBlock Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}"/>
        </Border>
    </Grid>
</Window>
